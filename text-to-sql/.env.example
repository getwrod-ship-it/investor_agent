# =============================================================================
# Text-to-SQL Agent configuration (MySQL-only, DeepSeek LLM, local BGE models)
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# --- LLM (DeepSeek — generates and explains the SQL) ---
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Local embedding / reranker models (see bge-embed-rerank-deploy.md) ------
# Paths are relative to the text-to-sql project root. Download the models with
# modelscope first (deploy guide section 2):
#   modelscope download --model BAAI/bge-m3 --local_dir models/bge-m3
#   modelscope download --model BAAI/bge-reranker-v2-m3 --local_dir models/bge-reranker-v2-m3
EMBEDDING_MODEL=models/bge-m3
EMBEDDING_DEVICE=cuda
RERANKER_MODEL=models/bge-reranker-v2-m3

# --- Business database (READ-ONLY access, MySQL only) ------------------------
# The URL scheme must be mysql — the agent rejects anything else:
#   mysql+pymysql://user:password@host:3306/dbname
BUSINESS_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb

# Optional: comma-separated tables the agent should never see or query
BUSINESS_DB_EXCLUDE_TABLES=

# --- Qdrant (vector store) ---------------------------------------------------
# Backend runs on the host (GPU local models); Qdrant runs in Docker with its
# port published:  docker compose up -d qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Agent behaviour ---
MAX_RETRIES=3
QUERY_TIMEOUT_SECONDS=30
QUERY_ROW_LIMIT=1000
# How many recent turns within one session are kept VERBATIM in the agent
# context; older turns are folded into a rolling LLM summary
MEMORY_WINDOW_SIZE=5

# --- Session persistence & memory compression ---
# LangGraph checkpoint store (conversation state; thread_id = session_id)
CHECKPOINT_DB_PATH=data/checkpoints.db
# Rolling summary of turns that fell out of the memory window
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_MAX_CHARS=600

# --- Long-term memory (mem0, see docs/DESIGN_long_term_memory.md) ---
# Master switch: false → recall returns empty and writes are no-ops (fail-open).
MEMORY_ENABLED=true
# Single-user identity key for cross-session memory (thread-local seam: future
# multi-user upgrades move this to a request-level field)
MEM0_USER_ID=default
# Qdrant collections + separate SQLite history files (lock isolation)
MEM0_FACTS_COLLECTION=text2sql_memory_facts
MEM0_EPISODIC_COLLECTION=text2sql_memory_episodic
MEM0_FACTS_HISTORY_DB=data/mem0_facts.db
MEM0_EPISODIC_HISTORY_DB=data/mem0_episodic.db
# Recall budgets: facts ≤top_k with score≥threshold, episodes ≤top_k
MEM0_FACTS_TOP_K=5
MEM0_FACTS_SCORE_THRESHOLD=0.5
MEM0_EPISODIC_TOP_K=2
# Per-leg recall timeout (seconds) — beyond it that leg degrades to empty
MEM0_RECALL_TIMEOUT_SECONDS=1.5

# --- Local decision model (StartLux-Decision, docs/DESIGN_local_decision_model.md) ---
# All gates are OFF by default and fail-open: with the switch off (or the
# service down) every gate returns "unknown" and the pipeline behaves exactly
# like the DeepSeek-only version. Requires the local decision service first
# (separate sibling folder):  startlux-decision\scripts\start_server.ps1
# DECISION_ENABLED=false
# DECISION_BASE_URL=http://127.0.0.1:9090
# DECISION_TIMEOUT_SECONDS=2.0
# DECISION_SHADOW_MODE=false
# DECISION_GUARD_ENABLED=true
# DECISION_INTENT_THRESHOLD=0.70
# DECISION_LTM_GATE_ENABLED=true
# DECISION_LTM_GATE_THRESHOLD=0.60
# DECISION_WRITE_GATE_ENABLED=true
# DECISION_REWRITE_GATE_ENABLED=true

# --- Application ---
APP_ENV=local   # local | production
